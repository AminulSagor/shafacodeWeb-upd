# Copy to .env.local and fill in. Never commit real values.

# Site
APP_ENV=                      # "production" enables indexing
# Admin sessions (32+ random characters, e.g. `openssl rand -base64 48`)
SESSION_SECRET=
# Bootstrap only: signs in once while the admins collection is empty and
# becomes the first owner. Without Firestore (local dev) this is the dev login.
ADMIN_USER=
ADMIN_PASS=

# Scheduled publishing: Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Firebase Admin (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # enables private buckets and signed uploads
# Production only: keep the old public-bucket uploads until the key above is set.
# Files uploaded this way are public. Leave unset once signed uploads work.
ALLOW_LEGACY_UPLOADS=

# Mail (Zoho SMTP)
ZOHO_HOST=
ZOHO_PORT=
ZOHO_USER=
ZOHO_PASS=
TO_EMAIL=
